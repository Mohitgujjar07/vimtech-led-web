# ==============================================================================
# VIMTECH Lab Ledger — Environment Configuration Template
# Copy this file to .env.local and configure values for your environment.
# DO NOT commit .env.local or any real secrets to source control.
# ==============================================================================

# Supabase Database & Storage Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini AI API Key (used for handwritten ledger OCR)
GEMINI_API_KEY=your-gemini-api-key

# Faculty Administrative Authentication Credentials
LAB_ADMIN_USERNAME=admin
LAB_ADMIN_PASSWORD=change-this-to-a-secure-password-in-production

# Cryptographic Session Secret (HMAC-SHA256 signing secret, min 32 chars)
SESSION_SECRET=change-this-to-a-random-32-character-secret-in-production

# Vercel Cron Secret (Bearer token for automated weekly Excel backup job)
CRON_SECRET=your-secure-cron-secret-token
