{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "crons": [
    {
      "path": "/api/backup",
      "schedule": "0 3 * * 1"
    }
  ],
  "functions": {
    "app/api/ocr/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/backup/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}

